{
  "name": "twentyfour-seven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "art:lint": "tsx scripts/qc-art-lint.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:visual": "playwright test tests/visual",
    "e2e:update": "playwright test tests/visual --update-snapshots",
    "secrets:check": "tsx scripts/secrets-check.ts",
    "qc:static": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run art:lint",
    "qc": "npm run qc:static && npm run test:cov && npm run secrets:check && npm run e2e",
    "qc:prod": "BASE_URL=${PROD_URL:-https://twentyfour-seven.vercel.app} playwright test tests/e2e --project=iphone --project=chrome-desktop && lhci autorun --collect.url=${PROD_URL:-https://twentyfour-seven.vercel.app}/login",
    "icons": "tsx scripts/gen-icons.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.9.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
